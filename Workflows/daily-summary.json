        0,
        0
      ],
      "id": "5aa57b36-6bcd-4ecf-a162-dfd530d2f2b6",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "leads",
        "returnAll": true,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "created_at",
              "condition": "gte",
              "keyValue": "={{ $now.minus({ days: 1 }).toUTC().toISO() }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        224,
        0
      ],
      "id": "b61c9aec-9464-46c7-9f3d-558eb1ef6bba",
      "name": "Get recent leads",
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "dFcU2yUXhJZY0KSr",
          "name": "Supabase lead-pipeline"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const leads = $input.all().map(i => i.json).filter(l => l.id);\nconst total = leads.length;\nconst avg = total\n  ? (leads.reduce((sum, l) => sum + (l.score || 0), 0) / total).toFixed(1)\n  : 0;\nconst count = (cat) => leads.filter(l => l.category === cat).length;\nconst top = [...leads]\n  .sort((a, b) => (b.score || 0) - (a.score || 0))\n  .slice(0, 3)\n  .map(l => `${l.name} (${l.company}) - score ${l.score}`)\n  .join('\\n') || 'No leads today';\n\nreturn [{\n  json: {\n    total,\n    avg,\n    hot: count('hot'),\n    warm: count('warm'),\n    cold: count('cold'),\n    top\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "20c702f7-46e6-4570-916d-88213135ab5f",
      "name": "Build summary"
    },
    {
      "parameters": {
        "sendTo": "YOUR_EMAIL_HERE,"
        "subject": "=Daily lead summary: {{ $json.total }} new leads",
        "emailType": "text",
        "message": "=Leads in the last 24 hours: {{ $json.total }}\nAverage score: {{ $json.avg }}\nHot: {{ $json.hot }} | Warm: {{ $json.warm }} | Cold: {{ $json.cold }}\n\nTop leads:\n{{ $json.top }}",
        "options": {}
      },
